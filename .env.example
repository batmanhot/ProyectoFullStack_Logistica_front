# ── Backend Django REST Framework ────────────────────────────
# URL base de la API. Sin barra final.
# Desarrollo local : http://localhost:8000/api
# Producción       : https://api.tudominio.com/api
VITE_API_URL=http://localhost:8000/api

# ── Modo de persistencia ──────────────────────────────────────
# 'local'   → localStorage (frontend puro, sin backend)
# 'api'     → Django REST Framework (activar cuando el backend esté listo)
VITE_STORAGE_MODE=local

# ── Web Push (Fase 2) — debe coincidir con VAPID_PUBLIC_KEY del backend ──────
VITE_VAPID_PUBLIC_KEY=
