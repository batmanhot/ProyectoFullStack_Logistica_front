# ── Backend NestJS (stockpro-api) ────────────────────────────
# URL base de la API. Sin barra final.
# Desarrollo local : http://localhost:3000/api
# Producción       : https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# ── Modo de persistencia ──────────────────────────────────────
# 'local'   → localStorage (frontend puro, sin backend)
# 'api'     → NestJS + PostgreSQL (modo real, activo desde Fase L)
VITE_STORAGE_MODE=local

# ── Web Push (Fase 2) — debe coincidir con VAPID_PUBLIC_KEY del backend ──────
VITE_VAPID_PUBLIC_KEY=
